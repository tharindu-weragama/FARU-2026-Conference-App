
<section class="bg-white px-5 py-6">
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-lg font-extrabold text-faru-green">
      Conference Updates
    </h2>

    <a
      href="/updates"
      class="text-sm font-semibold text-faru-green underline underline-offset-4"
    >
      View All
    </a>
  </div>

  <div id="home-updates-preview" class="mt-3 space-y-3">
    <p class="rounded-xl bg-faru-cream p-4 text-sm text-faru-muted">
      Loading conference updates...
    </p>
  </div>
</section>

<script>
  import {sanityClient, updatesQuery} from '../lib/sanity'

  interface Update {
    title: string
    message: string
    sessionName?: string
    venue?: string
    status?: string
    featured?: boolean
    featuredUntil?: string
  }

  async function loadHomeUpdates() {
    const container = document.getElementById('home-updates-preview')
    if (!container) return

    try {
      const updates = await sanityClient.fetch<Update[]>(updatesQuery)

      const featured = updates
        .filter((item) =>
          item.featured === true &&
          (!item.featuredUntil ||
            new Date(item.featuredUntil).getTime() > Date.now())
        )
        .slice(0, 2)

      container.replaceChildren()

      if (featured.length === 0) {
        container.textContent = 'No current conference updates.'
        return
      }

      for (const item of featured) {
        const card = document.createElement('article')
        card.className =
          'rounded-xl border-l-4 border-faru-lime bg-faru-cream p-4'

        const title = document.createElement('h3')
        title.className = 'text-sm font-bold text-faru-green'
        title.textContent = item.title

        const message = document.createElement('p')
        message.className = 'mt-2 text-sm leading-6 text-faru-muted'
        message.textContent = item.message

        card.append(title, message)

        if (item.sessionName || item.venue || item.status) {
          const details = document.createElement('p')
          details.className = 'mt-3 text-xs font-semibold text-faru-green'

          const statusLabels: Record<string, string> = {
            scheduled: 'Scheduled',
            inProgress: 'In Progress',
            delayed: 'Delayed',
            completed: 'Completed',
            cancelled: 'Cancelled',
          }

          details.textContent = [
            item.sessionName,
            item.venue,
            item.status
              ? statusLabels[item.status] ?? item.status
              : '',
          ].filter(Boolean).join(' • ')

          card.append(details)
        }

        container.append(card)
      }
    } catch (error) {
      console.error('Failed to load Home updates:', error)
      container.textContent = 'Conference updates are temporarily unavailable.'
    }
  }

  loadHomeUpdates()
</script>
