
---
import BaseLayout from '../layouts/BaseLayout.astro';

const keynoteSpeakers = [
  {
    name: 'Prof. Ian Dixon',
    image: '/images/speakers/ian-dixon.webp',
    date: '27 November 2026',
    venue: 'University of Moratuwa',
  },
  {
    name: 'Dr. Somsook Boonyabancha',
    image: '/images/speakers/somsook-boonyabancha.webp',
    date: '28 November 2026',
    venue: 'Jetwing Lighthouse Hotel, Galle',
  },
  {
    name: 'Mr. Johan Gély',
    image: '/images/speakers/johan-gely.webp',
    date: '28 November 2026',
    venue: 'Jetwing Lighthouse Hotel, Galle',
  },
];

const featuredSpeakers = [
  { name: 'Mr. Rusiru Abeyasinghe', initials: 'RA' },
  { name: 'Mr. Dmitri Cooray', initials: 'DC' },
];
---

<BaseLayout title="Speakers">
  <section class="bg-faru-green px-5 py-7 text-white">
    <p class="text-xs font-semibold uppercase tracking-widest text-faru-turquoise">
      FARU 2026
    </p>
    <h1 class="mt-2 text-[28px] font-extrabold">
      Conference Speakers
    </h1>
    <p class="mt-2 text-sm text-white/85">
      Keynote and featured speakers
    </p>
  </section>

  <section class="bg-[#eef7f8] px-4 py-6">
    <h2 class="mb-4 text-lg font-bold text-faru-green">
      Keynote Speakers
    </h2>

    <div class="space-y-3">
      {keynoteSpeakers.map((speaker) => (
        <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
          <div class="flex items-center gap-4 p-4">
            <img
              src={speaker.image}
              alt={speaker.name}
              width="88"
              height="88"
              loading="lazy"
              class="h-[88px] w-[88px] shrink-0 rounded-xl object-cover"
            />
            <div class="min-w-0">
              <p class="text-xs font-semibold text-[#417e62]">
                Keynote Speaker
              </p>
              <h3 class="mt-1 text-base font-extrabold leading-5 text-faru-green">
                {speaker.name}
              </h3>
              <p class="mt-2 text-xs text-faru-muted">
                {speaker.date}
              </p>
            </div>
          </div>

          <div class="border-t border-gray-100 px-4 py-3">
            <p class="text-xs text-faru-muted">{speaker.venue}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-white px-4 py-6">
    <h2 class="mb-4 text-lg font-bold text-faru-green">
      Featured Speakers
    </h2>

    <div class="space-y-3">
      {featuredSpeakers.map((speaker) => (
        <article class="flex items-center gap-4 rounded-xl border border-gray-200 p-4">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-xl bg-[#e5f3f1]">
            <span class="text-lg font-bold text-faru-green">
              {speaker.initials}
            </span>
          </div>
          <div>
            <p class="text-xs font-semibold text-[#417e62]">
              Featured Speaker
            </p>
            <h3 class="mt-1 font-bold text-faru-green">
              {speaker.name}
            </h3>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-faru-cream px-5 py-6">
    <div class="rounded-xl bg-white p-4">
      <h2 class="font-bold text-faru-green">
        Speaker Abstracts
      </h2>
      <p class="mt-2 text-sm leading-6 text-faru-muted">
        Presentation abstracts and additional speaker details
        will be included once supplied by the conference organisers.
      </p>
    </div>
  </section>
</BaseLayout>
