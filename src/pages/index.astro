
---
import BaseLayout from '../layouts/BaseLayout.astro'

const statistics = [
  {
    value: '93',
    label: 'Research Papers',
    icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M8 13h8 M8 17h8',
  },
  {
    value: '15',
    label: 'Technical Sessions',
    icon: 'M3 4h18v16H3z M3 10h18 M8 2v4 M16 2v4 M7 14h3 M14 14h3',
  },
  {
    value: '6',
    label: 'Research Themes',
    icon: 'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z',
  },
]

const topics = [
  {
    title: 'Green products, buildings and cities',
    description:
      'To explore environmentally sustainable products, buildings and urban environments.',
    image: '/images/themes/Theme 1.png',
  },
  {
    title: 'Technology for simulating-built form',
    description:
      'To examine technologies for modelling, simulating and analysing the built environment.',
    image: '/images/themes/Theme 2.png',
  },
  {
    title: 'Making places for people',
    description:
      'To explore people-centred approaches to creating inclusive and liveable places.',
    image: '/images/themes/Theme 3.png',
  },
  {
    title: 'Methods, tools and practices in delivering sustainable solutions',
    description:
      'To examine practical methods and tools for achieving sustainable built-environment solutions.',
    image: '/images/themes/Theme 4.png',
  },
  {
    title: 'Integrated systems, policy and governance',
    description:
      'To explore how interconnected systems, policies and governance contribute to sustainable development.',
    image: '/images/themes/Theme 5.png',
  },
  {
    title: 'Sustainable construction management',
    description:
      'To investigate sustainable practices and approaches in construction planning and management.',
    image: '/images/themes/Theme 6.png',
  },
]

type Speaker = {
  name: string
  role: string
  image: string
  profileUrl?: string
}

const sessions: {
  day: string
  date: string
  venue: string
  speakers: Speaker[]
}[] = [
  {
    day: 'DAY 01',
    date: '27 November 2026',
    venue: 'Rubert Peiris Auditorium, University of Moratuwa',
    speakers: [
      {
        name: 'Prof. Ian Dixon',
        role: 'Keynote Speaker',
        image: '/images/speakers/Ian Dixon.png',
        profileUrl: 'https://dr.ntu.edu.sg/entities/person/Ian-Dixon',
      },
    ],
  },
  {
    day: 'DAY 02',
    date: '28 November 2026',
    venue: 'Jetwing Lighthouse Hotel, Galle',
    speakers: [
      {
        name: 'Mr. Johan Gély',
        role: 'Keynote Speaker',
        image: '/images/speakers/Johan Gély.png',
      },
      {
        name: 'Mr. Rusiru Abeysinghe',
        role: 'Featured Speaker',
        image: '/images/speakers/Rusiru Abeysinghe.png',
      },
      {
        name: 'Mr. Dmitri Cooray',
        role: 'Featured Speaker',
        image: '/images/speakers/Dmitri Cooray.png',
      },
    ],
  },
]
---

<BaseLayout title="Home">

  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-faru-turquoise text-white">
    <img
      src="/images/branding/faru-cityscape.png"
      alt=""
      class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-auto w-full"
      width="1024"
      height="330"
      fetchpriority="high"
    />

    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[82%] bg-gradient-to-b from-faru-green via-faru-green/95 to-transparent"
    ></div>

    <div class="relative z-10 px-5 pb-[150px] pt-7">
      <p class="text-sm font-medium text-faru-turquoise">
        Welcome to
      </p>

      <h1 class="mt-2 text-[29px] font-extrabold leading-tight">
        FARU 2026
      </h1>

      <p class="mt-3 text-[21px] font-bold leading-tight">
        Resilient Intelligence
      </p>

      <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/90">
        Adapting the Built Environment to a Changing World
      </p>

      <div class="mt-5 space-y-1 text-sm">
        <p class="font-semibold">
          27–28 November 2026
        </p>
        <p class="leading-5">
          University of Moratuwa, Katubedda, Sri Lanka
        </p>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="bg-[#eef7f8] px-5 py-6">
    <h2 class="text-xl font-extrabold text-faru-green">
      About the Conference
    </h2>

    <p class="mt-3 text-[15px] leading-[1.7] text-[#344b40]">
      The 19th International Research Conference of the Faculty of
      Architecture Research Unit focuses on how we design, plan and
      manage the built environment in response to growing global
      challenges, including climate uncertainty, rapid urbanisation,
      evolving social dynamics and technological change.
    </p>

    <p class="mt-3 text-[15px] leading-[1.7] text-[#344b40]">
      Under the theme "Resilient Intelligence", FARU 2026 highlights
      the role of human insight, technological innovation and
      interdisciplinary collaboration in creating adaptive,
      resilient and sustainable futures.
    </p>
  </section>

  <!-- Conference at a Glance -->
  <section class="bg-[#eef7f8] px-4 pb-7">
    <div class="rounded-2xl bg-white px-4 py-4 text-center shadow-sm">
      <h2 class="text-lg font-extrabold text-faru-green">
        Conference at a Glance
      </h2>
    </div>

    <div class="mt-3 grid grid-cols-2 gap-3">
      {statistics.map((stat, index) => (
        <article
          class:list={[
            'flex min-h-[152px] flex-col items-center justify-center rounded-2xl bg-white px-3 py-4 text-center shadow-sm',
            index === 2 && 'col-span-2',
          ]}
        >
          <div class="mb-3 flex h-11 w-11 items-center justify-center rounded-xl bg-[#e5f3f1]">
            <svg
              width="25"
              height="25"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#417e62"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={stat.icon} />
            </svg>
          </div>

          <p class="text-[29px] font-extrabold leading-none text-faru-green">
            {stat.value}
          </p>

          <p class="mt-2 text-[12px] font-semibold leading-5 text-faru-muted">
            {stat.label}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Research Themes -->
  <section class="bg-[#eef7f8] pb-7">
    <div class="bg-faru-green px-5 py-3">
      <h2 class="text-center text-lg font-bold text-white">
        Research Thematic Areas
      </h2>
    </div>

    <div class="space-y-3 px-4 pt-4">
      {topics.map((topic, index) => (
        <article class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm">

          <div class="flex h-[100px] w-[100px] shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-100 bg-white">
            <img
              src={topic.image}
              alt={`Illustration for ${topic.title}`}
              width="100"
              height="100"
              loading="lazy"
              class="h-full w-full object-contain"
            />
          </div>

          <div class="min-w-0 flex-1">
            <p class="mb-1 text-[10px] font-bold uppercase tracking-wide text-[#417e62]">
              Theme {index + 1}
            </p>

            <h3 class="text-sm font-bold leading-5 text-faru-green">
              {topic.title}
            </h3>

            <p class="mt-1 text-[12px] leading-[1.5] text-faru-muted">
              {topic.description}
            </p>
          </div>

        </article>
      ))}
    </div>
  </section>

  <!-- Speakers -->
  <section class="bg-white px-4 py-7">
    <h2 class="px-1 text-xl font-extrabold text-faru-green">
      Keynote &amp; Featured Speakers
    </h2>

    <p class="mt-1 px-1 text-sm text-faru-muted">
      FARU 2026 conference speakers
    </p>

    <div class="mt-4 space-y-4">
      {sessions.map((session) => (
        <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white">

          <div class="flex items-center justify-between gap-3 bg-[#e5f3f1] px-4 py-3">
            <span class="text-xs font-extrabold text-faru-green">
              {session.day}
            </span>

            <span class="text-xs text-faru-muted">
              {session.date}
            </span>
          </div>

          <div class="p-4">
            <div class="space-y-4">
              {session.speakers.map((speaker) => (
                <div class="flex items-center gap-4">

                  <div class="flex h-[88px] w-[88px] shrink-0 items-center justify-center overflow-hidden rounded-xl border border-gray-100 bg-[#f6f8f7]">
                    <img
                      src={speaker.image}
                      alt={speaker.name}
                      width="88"
                      height="88"
                      loading="lazy"
                      class="h-full w-full object-contain"
                    />
                  </div>

                  <div class="min-w-0 flex-1">
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-[#417e62]">
                      {speaker.role}
                    </p>

                    <h3 class="mt-1 text-[15px] font-bold leading-5 text-faru-green">
                      {speaker.name}
                    </h3>

                    {speaker.profileUrl && (
                      <a
                        href={speaker.profileUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-[#417e62] underline underline-offset-2"
                      >
                        View Academic Profile
                        <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>

                </div>
              ))}
            </div>

            <p class="mt-4 border-t border-gray-100 pt-3 text-xs text-faru-muted">
              {session.venue}
            </p>
          </div>

        </article>
      ))}
    </div>
  </section>

</BaseLayout>
