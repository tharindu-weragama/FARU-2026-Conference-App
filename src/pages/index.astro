
---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveUpdatesPreview from '../components/LiveUpdatesPreview.astro'


const statistics = [
  {
    value: 'TBA',
    label: 'Speakers and Presenters',
    icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8a4 4 0 0 0 0 8M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
  {
    value: 'TBA',
    label: 'Registrations',
    icon: 'M9 12l2 2 4-4M12 22a10 10 0 1 0 0-20a10 10 0 0 0 0 20z',
  },
  {
    value: 'TBA',
    label: 'Countries Represented',
    icon: 'M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20M2 12h20M12 2c3 3 4 7 4 10s-1 7-4 10M12 2c-3 3-4 7-4 10s1 7 4 10',
  },
  {
    value: '6',
    label: 'Research Areas',
    icon: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',
  },
];



const topics = [
  {
    title: 'Green products, buildings and cities',
    description: 'To explore environmentally sustainable products, buildings and urban environments.',
    image: '/images/themes/green-buildings.jpg',
  },
  {
    title: 'Technology for simulating-built form',
    description: 'To examine technologies for modelling, simulating and analysing the built environment.',
    image: '/images/themes/built-form-simulation.png',
  },
  {
    title: 'Making places for people',
    description: 'To explore people-centred approaches to creating inclusive and liveable places.',
    image: '/images/themes/places-for-people.jpg',
  },
  {
    title: 'Methods, tools and practices in delivering sustainable solutions',
    description: 'To examine practical methods and tools for achieving sustainable built-environment solutions.',
    image: '/images/themes/sustainable-solutions.png',
  },
  {
    title: 'Integrated systems, policy and governance',
    description: 'To explore how interconnected systems, policies and governance contribute to sustainable development.',
    image: '/images/themes/policy-governance.webp',
  },
  {
    title: 'Sustainable construction management',
    description: 'To investigate sustainable practices and approaches in construction planning and management.',
    image: '/images/themes/construction-management.webp',
  },
];


const sessions = [
  {
    day: 'DAY 01',
    date: '27 November 2026',
    venue: 'University of Moratuwa',
    speakers: [
      {
        name: 'Prof. Ian Dixon',
        image: '/images/speakers/ian-dixon.webp',
      },
    ],
  },
  {
    day: 'DAY 02',
    date: '28 November 2026',
    venue: 'Jetwing Lighthouse Hotel, Galle',
    speakers: [
      {
        name: 'Dr. Somsook Boonyabancha',
        image: '/images/speakers/somsook-boonyabancha.webp',
      },
      {
        name: 'Mr. Johan Gély',
        image: '/images/speakers/johan-gely.webp',
      },
    ],
  },
];

const sponsors = [
  {
    name: 'University of Moratuwa',
    image: '/images/branding/faru-organiser.png',
  },
  {
    name: 'Jetwing Hotels',
    image: '/images/sponsors/jetwing-hotels.webp',
  },
  {
    name: 'Macktiles',
    image: '/images/sponsors/macktiles.jpeg',
  },
  {
    name: 'Keells',
    image: '/images/sponsors/keells-logo.png',
  },
];
---

<BaseLayout title="Home">
  <section class="relative isolate overflow-hidden bg-faru-turquoise text-white">
    <img
      src="/images/branding/faru-cityscape.png"
      alt=""
      class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-auto w-full"
      width="1024"
      height="330"
      fetchpriority="high"
    />

    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[82%] bg-gradient-to-b from-faru-green via-faru-green/95 to-transparent"
    ></div>

    <div class="relative z-10 px-5 pb-[150px] pt-7">
      <p class="text-sm font-medium text-faru-turquoise">
        Welcome to
      </p>

      <h1 class="mt-2 text-[29px] font-extrabold leading-tight">
        FARU 2026
      </h1>

      <p class="mt-3 text-[21px] font-bold leading-tight">
        Resilient Intelligence
      </p>

      <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/90">
        Adapting the Built Environment to a Changing World
      </p>

      <div class="mt-5 space-y-1 text-sm">
        <p class="font-semibold">27–28 November 2026</p>
        <p class="leading-5">
          University of Moratuwa, Katubedda, Sri Lanka
        </p>
      </div>
    </div>
  </section>

  <section class="bg-[#eef7f8] px-5 py-6">
    <h2 class="text-xl font-extrabold text-faru-green">
      About the Conference
    </h2>

    <p class="mt-3 text-[15px] leading-[1.7] text-[#344b40]">
      The 19th International Research Conference of the Faculty of
      Architecture Research Unit focuses on how we design, plan and
      manage the built environment in response to growing global
      challenges, including climate uncertainty, rapid urbanisation,
      evolving social dynamics and technological change.
    </p>

    <p class="mt-3 text-[15px] leading-[1.7] text-[#344b40]">
      Under the theme "Resilient Intelligence", FARU 2026 highlights
      the role of human insight, technological innovation and
      interdisciplinary collaboration in creating adaptive,
      resilient and sustainable futures.
    </p>
  </section>

  <section class="bg-[#eef7f8] px-4 pb-7">
    <div class="rounded-2xl bg-white px-4 py-3 text-center shadow-sm">
      <h2 class="text-2xl font-extrabold text-faru-green">
        FARU 2026
      </h2>
      <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-faru-muted">
        Conference at a Glance
      </p>
    </div>

    <div class="mt-4 space-y-3">
      {statistics.map((stat, index) => (
        <article
          class:list={[
            'flex min-h-[128px] items-center justify-between gap-3 rounded-2xl bg-white p-4 shadow-sm',
            index % 2 === 1 && 'flex-row-reverse',
          ]}
        >
          <div class="w-[54%] text-center">
            <p class="text-[30px] font-extrabold leading-none text-faru-green">
              {stat.value}
            </p>
            <p class="mt-2 text-[13px] font-medium leading-5 text-faru-muted">
              {stat.label}
            </p>
          </div>

          <div class="flex h-[94px] w-[42%] items-center justify-center rounded-xl bg-[#e5f3f1]">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="58"
              height="58"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#417e62"
              stroke-width="1.3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={stat.icon} />
            </svg>
          </div>
        </article>
      ))}
    </div>
  </section>

<LiveUpdatesPreview />

  
<section class="bg-[#eef7f8] pb-6">

  <div class="bg-faru-green px-5 py-3">
    <h2 class="text-center text-lg font-bold text-white">
      Research Thematic Areas
    </h2>
  </div>

  <div class="space-y-3 px-4 pt-4">

    {topics.map((topic) => (
      <article class="flex items-center gap-3 rounded-xl bg-white p-3 shadow-sm">

        <img
          src={topic.image}
          alt=""
          width="92"
          height="92"
          loading="lazy"
          class="h-[92px] w-[92px] shrink-0 rounded-lg object-cover"
        />

        <div class="min-w-0 flex-1">

          <h3 class="text-sm font-bold leading-5 text-faru-green">
            {topic.title}
          </h3>

          <p class="mt-1 text-[13px] leading-[1.5] text-faru-muted">
            {topic.description}
          </p>

        </div>

      </article>
    ))}

  </div>

</section>


  <section class="bg-white px-5 py-7">
    <h2 class="text-xl font-extrabold text-faru-green">
      Keynote Sessions
    </h2>

    <p class="mt-1 text-sm text-faru-muted">
      Announced keynote speakers
    </p>

    <div class="mt-4 space-y-4">
      {sessions.map((session) => (
        <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white">
          <div class="flex items-center justify-between gap-3 bg-[#e5f3f1] px-4 py-3">
            <span class="text-xs font-extrabold text-faru-green">
              {session.day}
            </span>

            <span class="text-xs text-faru-muted">
              {session.date}
            </span>
          </div>

          <div class="p-4">
            <div class="space-y-4">
              {session.speakers.map((speaker) => (
                <div class="flex items-center gap-4">
                  <img
                    src={speaker.image}
                    alt={speaker.name}
                    width="72"
                    height="72"
                    loading="lazy"
                    class="h-[72px] w-[72px] shrink-0 rounded-xl object-cover"
                  />

                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-[#417e62]">
                      Keynote Speaker
                    </p>
                    <h3 class="mt-1 text-base font-bold leading-5 text-faru-green">
                      {speaker.name}
                    </h3>
                  </div>
                </div>
              ))}
            </div>

            <p class="mt-4 border-t border-gray-100 pt-3 text-sm text-faru-muted">
              {session.venue}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>


<footer class="bg-white px-4 py-5">
  <h2 class="mb-4 text-sm font-bold text-faru-green">
    Organised By
  </h2>

  <div class="grid grid-cols-4 items-center gap-3">
    <img
      src="/images/branding/faru-organiser.png"
      alt="University of Moratuwa"
      class="h-14 w-full object-contain"
      loading="lazy"
    />

    <img
      src="/images/sponsors/jetwing-hotels.webp"
      alt="Jetwing Hotels"
      class="h-14 w-full object-contain"
      loading="lazy"
    />

    <img
      src="/images/sponsors/macktiles.jpeg"
      alt="Macktiles"
      class="h-14 w-full object-contain"
      loading="lazy"
    />

    <img
      src="/images/sponsors/KeellsLogo.png"
      alt="Keells"
      class="h-14 w-full object-contain"
      loading="lazy"
    />
  </div>
</footer>


</BaseLayout>
