---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'FARU 2026 | 19th International Research Conference, University of Moratuwa, Sri Lanka.',
} = Astro.props;

const navigation = [
  {
    label: 'Home',
    href: '/',
    icon: 'M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5M9 21v-7h6v7',
  },
  {
    label: 'Programme',
    href: '/programme/',
    icon: 'M7 3v4M17 3v4M3 10h18M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z',
  },
  {
    label: 'Updates',
    href: '/updates/',
    icon: 'M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4',
  },
  {
    label: 'Venue',
    href: '/venue/',
    icon: 'M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0zM12 13a3 3 0 1 0 0-6a3 3 0 0 0 0 6',
  },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#8BCBD2" />

    <title>{title} | FARU 2026</title>

    <!-- OneSignal Web Push SDK -->
    <script
      is:inline
      src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js"
      defer
    ></script>

    <!-- OneSignal Production Initialization -->
    <script is:inline>
      if (
        window.location.origin ===
        'https://faru-2026-conference.vercel.app'
      ) {
        window.OneSignalDeferred = window.OneSignalDeferred || [];

        window.OneSignalDeferred.push(async function (OneSignal) {
          try {
            await OneSignal.init({
              appId: 'dbeb99b6-9240-45d7-a469-ef9f110bcc92',

              safari_web_id:
                'web.onesignal.auto.40e8587d-66e6-4615-b716-6bb570edb005',

              notifyButton: {
                enable: true,
                position: 'bottom-right',
                size: 'small',
                offset: {
                  bottom: '85px',
                  right: '15px',
                },
              },

              promptOptions: {
                slidedown: {
                  prompts: [
                    {
                      type: 'push',
                      autoPrompt: true,
                      delay: {
                        pageViews: 1,
                        timeDelay: 5,
                      },
                      text: {
                        actionMessage:
                          'Receive important FARU 2026 announcements and programme updates.',
                        acceptButton: 'Enable',
                        cancelButton: 'Not now',
                      },
                    },
                  ],
                },
              },

              welcomeNotification: {
                disable: true,
              },

              serviceWorkerPath: '/OneSignalSDKWorker.js',
            });

            console.info('FARU 2026 OneSignal initialized');
          } catch (error) {
            console.error(
              'FARU 2026 OneSignal initialization failed:',
              error
            );
          }
        });
      }
    </script>
  </head>

  <body class="m-0 bg-[#eaf1ef] font-sans antialiased">
    <div
      class="mx-auto flex h-dvh w-full max-w-[480px] flex-col overflow-hidden bg-faru-cream shadow-xl"
    >
      <header
        class="z-10 shrink-0 bg-faru-turquoise px-5 pb-3 text-faru-green"
        style="padding-top: max(12px, env(safe-area-inset-top))"
      >
        <a href="/" class="block w-fit">
          <div class="text-xl font-extrabold tracking-tight">
            FARU 2026
          </div>

          <p class="text-xs font-medium text-faru-green/80">
            19th International Research Conference
          </p>
        </a>
      </header>

      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3"
      >
        Skip to main content
      </a>

      <main
        id="main-content"
        tabindex="-1"
        class="min-h-0 flex-1 overflow-y-auto overscroll-contain"
      >
        <slot />
        <SiteFooter />
      </main>

      <nav
        aria-label="Main navigation"
        class="z-10 shrink-0 border-t border-gray-200 bg-white px-2 pt-2"
        style="padding-bottom: max(8px, env(safe-area-inset-bottom))"
      >
        <div class="grid grid-cols-4 gap-1">
          {navigation.map((item) => {
            const itemPath =
              item.href.replace(/\/+$/, '') || '/';

            const isActive =
              currentPath === itemPath;

            return (
              <a
                href={item.href}
                aria-current={
                  isActive ? 'page' : undefined
                }
                class:list={[
                  'flex min-h-[56px] flex-col items-center justify-center gap-1 rounded-lg transition-colors',
                  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-faru-green',
                  isActive
                    ? 'bg-faru-cream text-faru-green'
                    : 'text-gray-600 hover:bg-faru-cream/60 hover:text-faru-green',
                ]}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={item.icon} />
                </svg>

                <span class="text-[11px] font-semibold">
                  {item.label}
                </span>
              </a>
            );
          })}
        </div>
      </nav>
    </div>
  </body>
</html>